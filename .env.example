# OBSIDIAN_VAULT_PATH: Root path to your Obsidian vault
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault

# OBSIDIAN_ALLOWED_SUBPATHS: Optional comma-separated relative subdirectories allowed for access
# e.g., vault,projects,research
OBSIDIAN_ALLOWED_SUBPATHS=

# OBSIDIAN_READONLY: Set to 'true' to restrict agent actions to read-only
OBSIDIAN_READONLY=false
